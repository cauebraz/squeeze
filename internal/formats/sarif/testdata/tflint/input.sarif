{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "informationUri": "https://github.com/terraform-linters/tflint",
          "name": "tflint",
          "rules": [
            {
              "id": "terraform_required_providers",
              "shortDescription": {
                "text": ""
              },
              "helpUri": "https://github.com/terraform-linters/tflint-ruleset-terraform/blob/v0.15.0/docs/rules/terraform_required_providers.md"
            },
            {
              "id": "terraform_required_version",
              "shortDescription": {
                "text": ""
              },
              "helpUri": "https://github.com/terraform-linters/tflint-ruleset-terraform/blob/v0.15.0/docs/rules/terraform_required_version.md"
            },
            {
              "id": "terraform_typed_variables",
              "shortDescription": {
                "text": ""
              },
              "helpUri": "https://github.com/terraform-linters/tflint-ruleset-terraform/blob/v0.15.0/docs/rules/terraform_typed_variables.md"
            },
            {
              "id": "terraform_unused_declarations",
              "shortDescription": {
                "text": ""
              },
              "helpUri": "https://github.com/terraform-linters/tflint-ruleset-terraform/blob/v0.15.0/docs/rules/terraform_unused_declarations.md"
            }
          ],
          "version": "0.64.0"
        }
      },
      "results": [
        {
          "ruleId": "terraform_required_providers",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Missing version constraint for provider \"aws\" in `required_providers`"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 11,
                  "endLine": 5,
                  "endColumn": 6
                }
              }
            }
          ]
        },
        {
          "ruleId": "terraform_required_version",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "terraform \"required_version\" attribute is required"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 10
                }
              }
            }
          ]
        },
        {
          "ruleId": "terraform_typed_variables",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "`region` variable has no type"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 1,
                  "endLine": 9,
                  "endColumn": 18
                }
              }
            }
          ]
        },
        {
          "ruleId": "terraform_unused_declarations",
          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "variable \"region\" is declared but not used"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 1,
                  "endLine": 9,
                  "endColumn": 18
                }
              }
            }
          ]
        },
        {
          "ruleId": "terraform_unused_declarations",
          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "variable \"unused\" is declared but not used"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "main.tf"
                },
                "region": {
                  "startLine": 11,
                  "startColumn": 1,
                  "endLine": 11,
                  "endColumn": 18
                }
              }
            }
          ]
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "informationUri": "https://github.com/terraform-linters/tflint",
          "name": "tflint-errors",
          "rules": [],
          "version": "0.64.0"
        }
      },
      "results": []
    }
